# School Catchment Search - Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gnaf_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# Application
APP_HOST=127.0.0.1
APP_PORT=5000

# Logging
LOG_LEVEL=INFO

# Features
ENABLE_ICSEA=True
ENABLE_SCHOOL_URL=True

# Email – Password Reset (Gmail with App Password)
# Step-by-step to generate an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" if not already on
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Choose app = "Mail", device = "Other (custom name)" → type "PropertyDB"
#   5. Copy the 16-character password shown and paste it below (no spaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your.name@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxxxxxx
MAIL_DEFAULT_SENDER=your.name@gmail.com
